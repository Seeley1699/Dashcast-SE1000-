<?xml version="1.0" encoding="utf-8"?>
<!--
  危险操作按钮（停止 / 删除）。

  ══════════════════════════════════════════════════════════════
  为什么改成"描边"而不是"实底红"（2026-11-04 美化）
  ══════════════════════════════════════════════════════════════
  原来是实底红（#F85149），用作「停止」按钮视觉过重 ——
  屏幕上同时有「部署」（蓝实底）、「停止」（红实底）、
  「开始投屏」（蓝实底），三个大色块抢注意力，
  反而看不出哪个是当前主操作。

  改成：透明底 + 红色描边。
    · 危险语义还在（红色）
    · 不抢主操作的视觉焦点
    · 和蓝实底的主操作形成清晰层级
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_muted" />
            <stroke android:width="1dp" android:color="@color/surface_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/state_error_tint" />
            <stroke android:width="1.5dp" android:color="@color/state_error_press" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/state_error" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
