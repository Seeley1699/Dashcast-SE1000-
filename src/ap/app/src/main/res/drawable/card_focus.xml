<?xml version="1.0" encoding="utf-8"?>
<!--
  重点卡片（投屏控制区）。

  ══════════════════════════════════════════════════════════════════
  改中性描边（2026-11-04，按 MiUIX 规范）
  ══════════════════════════════════════════════════════════════════
  原来是 1.5dp 的强调蓝描边，在深色界面上非常抢眼 ——
  加上旁边还有蓝色实底的「部署」「开始投屏」按钮，
  整页到处是蓝色，主操作反而不突出了。

  MiUIX 的做法是：容器永远中性（outline 灰描边），
  蓝色只留给「当前可点的主操作」。所以这里改成 1dp outline。

  以后要强调某个卡片，用 surfaceContainerHighest (#2D2D2D) 换底色，
  而不是加蓝边。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card" />
            <stroke android:width="1dp" android:color="@color/surface_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
