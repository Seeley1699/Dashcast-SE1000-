<?xml version="1.0" encoding="utf-8"?>
<!-- 状态卡：左侧 5dp 状态色条 + 卡片底。色条颜色由 setDotColor() 动态设置 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card" />
            <stroke android:width="1dp" android:color="@color/surface_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:width="5dp" android:gravity="left">
        <shape android:shape="rectangle">
            <solid android:color="@color/state_idle" />
            <corners android:topLeftRadius="16dp" android:bottomLeftRadius="16dp" />
        </shape>
    </item>
</layer-list>
