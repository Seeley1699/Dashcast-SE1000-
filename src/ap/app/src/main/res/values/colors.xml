<!--
  ══════════════════════════════════════════════════════════════════
  全局色板 v7 —— ShipSwift 设计规范（2026-11-04）
  ══════════════════════════════════════════════════════════════════

  色值与尺寸**直接取自 ShipSwift 源码**（F:\Downloads\ShipSwift-main）：

    SWPackage/SWComponent/Display/SWKPICard.swift:139-149
      .padding(14)
      RoundedRectangle(cornerRadius: 16).fill(systemBackground)
      .shadow(color: .black.opacity(0.04), radius: 6, x: 0, y: 2)
      .overlay(RoundedRectangle(cornerRadius: 16)
                 .stroke(tint.opacity(0.15), lineWidth: 1))

    SWPackage/SWComponent/Display/SWStatusBadge.swift:99-110
      .font(.caption).fontWeight(.semibold)
      .padding(.horizontal, 10).padding(.vertical, 4)
      Capsule().fill(tint.opacity(0.18))
      Capsule().stroke(tint.opacity(0.35), lineWidth: 0.5)

    SWPackage/SWComponent/Input/SWSearchBar.swift:56-59
      .font(.system(size: 14))
      .padding(.horizontal, 12).padding(.vertical, 8)
      .background(.ultraThinMaterial, in: .capsule)

    SWKPICard.swift:296（预览里的页面底色）
      .background(Color.gray.opacity(0.06))   ← 浅灰页面

  ══════════════════════════════════════════════════════════════════
  **这是一套浅色 UI**（用户要求：背景不要黑色，用 #F5F5F5）
  ══════════════════════════════════════════════════════════════════

  和之前的深色方案相比，核心差别：

    深色（MiUIX）          浅色（ShipSwift）
    ─────────────────────────────────────────
    卡片和背景同色          卡片是纯白，浮在浅灰上
    靠描边分层              靠**阴影**分层（0.04 极淡）
    文字用透明度分级        文字用灰阶（黑/深灰/中灰）
    无阴影                  有阴影 radius 6, y 2

  分层的原理完全不同：浅色 UI 是"白纸浮在灰桌上"，
  阴影是唯一的层级线索，不能省。

  ── 色值 ──
    页面底 #F5F5F5  ← Color.gray.opacity(0.06) 在白色上的等效值
    卡片   #FFFFFF  ← systemBackground
    阴影   黑 4%    ← .black.opacity(0.04)
    分隔线 #E5E5E5  ← SwiftUI Divider 默认色
    主文字 #1C1C1E  ← .primary（iOS label）
    次文字 #8E8E93  ← .secondary（iOS secondaryLabel）
    弱文字 #C7C7CC  ← .tertiary
    主色   #007AFF  ← iOS systemBlue
-->

<resources>

    <!-- ══ 背景：浅灰页面 + 白色卡片 ══ -->
    <!-- 页面底：Color.gray.opacity(0.06) 叠在白底上的等效值 -->
    <color name="surface_root">#FFF3F3F2</color>
    <!-- 卡片：systemBackground -->
    <color name="surface_card">#FFFFFFFF</color>
    <!-- 次级面（搜索框/输入区）：比卡片略灰，用于区分可交互区 -->
    <color name="surface_raised">#FFEDEDEB</color>
    <!-- 按下态：iOS 的 systemFill 概念 -->
    <color name="surface_raised_press">#FFE0E0DD</color>
    <!-- 描边：iOS separator -->
    <color name="surface_border">#FFE4E4E1</color>
    <!-- 禁用底 -->
    <color name="surface_muted">#FFECECEA</color>
    <!-- 预览区（画布）：纯白，让网格线清晰 -->
    <color name="surface_deep">#FFFAFAF9</color>

    <!-- ══ 文字：iOS label 三级 ══ -->
    <color name="content_primary">#FF1C1C1E</color>     <!-- 深灰（原纯黑，对比度 21:1→11:1 更柔和） -->
    <color name="content_secondary">#FF6B6B70</color>   <!-- 中深灰 -->
    <color name="content_tertiary">#FF9A9A9F</color>    <!-- 弱文字 -->
    <color name="content_quaternary">#FF9A9A9F</color>
    <!-- 强调文字：用户要求所有文字纯黑，故改 #000000（原 #007AFF） -->
    <color name="content_accent">#FF1C1C1E</color>


    <!-- ══ 主色：iOS systemBlue ══ -->
    <color name="accent">#FF007AFF</color>
    <color name="accent_press">#FF0062CC</color>
    <color name="accent_on">#FFFFFFFF</color>
    <!--
      accent_soft 被 14 处按钮文字引用，取主色深一档保证白卡上对比度达标。



    -->
    <color name="accent_soft">#FF0A6FD8</color>

    <color name="accent_tint">#0F007AFF</color>

    <!-- ══ 语义状态：iOS 系统色 ══ -->
    <color name="state_ok">#FF34C759</color>            <!-- systemGreen -->
    <color name="state_ok_tint">#2E34C759</color>
    <color name="state_warn">#FFFF9500</color>          <!-- systemOrange -->
    <color name="state_warn_tint">#2EFF9500</color>
    <color name="state_error">#FFFF3B30</color>         <!-- systemRed -->
    <color name="state_error_press">#FFD92B21</color>
    <color name="state_error_tint">#2EFF3B30</color>
    <color name="state_idle">#FF8E8E93</color>          <!-- .secondary -->
    <color name="state_idle_tint">#1F8E8E93</color>

    <!-- ══ 胶囊标签：SWStatusBadge 规范（tint×0.18 底 + tint×0.35 描边）══ -->
    <color name="pill_on">#FF007AFF</color>
    <color name="pill_on_text">#FFFFFFFF</color>
    <!-- 未选中：surfaceRaised 底（浅灰），文字用主色 -->
    <color name="pill_off">#FFF0F0F3</color>
    <color name="pill_off_text">#FF007AFF</color>
    <color name="pill_off_border">#FFD1D1D6</color>

    <!-- ══ 兼容别名 ══ -->
    <color name="bg">@color/surface_root</color>
    <color name="card_bg">@color/surface_card</color>
    <color name="card_border">@color/surface_border</color>
    <color name="btn_surface">@color/surface_raised</color>
    <color name="btn_surface_press">@color/surface_raised_press</color>
    <color name="accent_dim">@color/accent_press</color>
    <color name="warn">@color/state_warn</color>
    <color name="danger">@color/state_error</color>
    <color name="text_main">@color/content_primary</color>
    <color name="text_sub">@color/content_secondary</color>
    <color name="btn_disabled">@color/surface_muted</color>
    <color name="text_disabled">@color/content_tertiary</color>
    <color name="divider">#FFE5E5E5</color>

    <!-- ══ 阴影（ShipSwift: .black.opacity(0.04), radius 6, y 2）══ -->
    <color name="card_shadow">#0A000000</color>          <!-- 4% 黑 -->

</resources>
