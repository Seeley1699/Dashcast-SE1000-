<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hermes.dashcast">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- 本地存储：预设配置和运行日志落盘到 Download/Dashcast/ -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- 建 PUBLIC 虚拟屏的系统权限（signature|privileged，普通安装拿不到，
         留作 priv-app 部署用；拿不到时走 MediaProjection token 那条路） -->
    <uses-permission android:name="android.permission.CAPTURE_VIDEO_OUTPUT" />
    <!-- Android 11+ 包可见性：允许查询设备上所有已安装 App（选择投屏目标需要） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 投放当前前台 App：moveTaskToDisplay 需要（signature|privileged，工程固件可装） -->
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_TASKS" />

    <!--
        桌面浮窗（overlay）。

        **这是做"浮在桌面上的小窗"的必要条件**（2026-11-07 实测）：
        Activity + resizeableActivity 只能让窗口不铺满**自己的任务栈**，
        一旦按 HOME 或者桌面盖上来，Activity 窗口就被挡住/退到后面。
        真正浮在所有应用之上的只有 WindowManager 的 overlay 窗口，
        而它必须持有 SYSTEM_ALERT_WINDOW。

        appops 实测：未声明时 `appops set ... allow` 写入无效
        （dumpsys appops 里永远是 "SYSTEM_ALERT_WINDOW (default)" 带 Reject 记录）。
        声明之后才能通过「设置 → 应用 → 显示在其他应用上层」或 adb appops 授权。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="Dashcast"
        android:name=".DashcastApp"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Dashcast"
        android:allowBackup="false">

        <!--
            主界面。

            **必须 singleTask**：默认 standard 模式下每一次 am start 都会新建一个
            Activity 实例，每个实例都挂一个 fillxfill 的全屏窗口。实测从 launcher
            点几次、adb 再 start 几次，同一个进程里就堆出 3 个
            com.hermes.dashcast/MainActivity 窗口（token 各不同），
            结果仪表上看到「几份相同画面叠在一起」—— 被误判成投屏重影。

            singleTask 保证栈里只有一个实例，再次启动只是把它 bringToFront。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!-- 镜像模式：只用来把进程钉在前台，逻辑在 Activity 进程里 -->
        <service
            android:name=".KeepAliveService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- 可视化图层布局编辑器：圆角/梯形/羽化形状遮罩，参数即时下发到 dcapd2。
             同样要 singleTask —— 反复进编辑器不该堆多个实例。 -->
        <activity
            android:name=".LayerEditorActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:label="图层布局" />

        <!-- 联调用：一块确定会动的 60fps 内容源，没有 launcher 入口。
             用法：am start 时用 display 参数指定虚拟屏 id -->
        <activity
            android:name=".TestPatternActivity"
            android:exported="true"
            android:launchMode="singleInstance" />

        <!--
            浮窗（overlay）测试页。

            MiniWindowActivity 是「Activity 不铺满」，按 HOME 会退到后台；
            MiniOverlay 是「WindowManager overlay」，浮在所有 App 之上。
            这个测试页两者都能验，用来对比。

            用法：
              adb shell am start -n com.hermes.dashcast/.OverlayTestActivity
        -->
        <activity
            android:name=".OverlayTestActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="浮窗测试" />

        <!--
            小窗（浮窗）。

            配置对齐银河视界的 SrMiniActivity（车机浮窗的既有范式）：
              · taskAffinity 独立      → 不和主界面挤同一个任务栈
              · launchMode=singleTask  → 反复拉起只 bringToFront，不堆实例
              · resizeableActivity=true → 允许系统给它非全屏尺寸
              · configChanges 0x1f80   = orientation|screenSize|screenLayout|density
                （尺寸变化时不重建 Activity，浮窗才不会闪一下）

            exported=true 只为能用 adb 直接 start 调试验证；
            正式入口走 MainActivity 里的 MiniWindowActivity.launch()。
        -->
        <activity
            android:name=".MiniWindowActivity"
            android:exported="true"
            android:taskAffinity="com.hermes.dashcast.mini"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density"
            android:resizeableActivity="true"
            android:label="小窗测试" />

        <!-- 联调用：adb shell am broadcast -a com.hermes.dashcast.DIAG
             把 CP（仪表）和 AP（中控）两边的状态一次性打到 logcat。

             **CPCMD 在 CP 上以 root 执行任意命令**（还能 push 落地二进制）。
             加固方式与取舍（2026-11-01）：
               ① 试过 signature 级自定义权限 —— 三方 App 确实挡得住，
                  但**把 adb shell 调试也一起挡死了**（adb 没我们的签名，
                  am 的 receiver-permission 参数在这台车机上也无效）。
                  车机上唯一的调试通道就是 adb，堵死它得不偿失。
               ② 最终方案：保持 exported=true，在 DiagReceiver.onReceive 里
                  按发送方 uid 校验（本 App / root / shell / system 放行）。
                  拿不到 uid 时放行并记日志 —— 这台车机的 framework 上
                  getSentFromUid() 运行时会 NoSuchMethodError，实际总是拿不到，
                  所以第一道防线在 uid 上不可靠，**主要靠"广播 action 名字
                  不公开、且只有 root/adb 才知道用法"这一层模糊防护**。
               ③ 真要收紧：把 exported 改成 false，然后在 MainActivity 里
                  加一个诊断按钮走进程内调用（不再依赖广播）。 -->
        <receiver
            android:name=".DiagReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.hermes.dashcast.DIAG" />
                <action android:name="com.hermes.dashcast.CPCMD" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
