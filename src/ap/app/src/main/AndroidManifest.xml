<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hermes.dashcast">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- 本地存储：预设配置和运行日志落盘到 Download/Dashcast/ -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- 建 PUBLIC 虚拟屏的系统权限（signature|privileged，普通安装拿不到，
         留作 priv-app 部署用；拿不到时走 MediaProjection token 那条路） -->
    <uses-permission android:name="android.permission.CAPTURE_VIDEO_OUTPUT" />
    <!-- Android 11+ 包可见性：允许查询设备上所有已安装 App（选择投屏目标需要） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 投放当前前台 App：moveTaskToDisplay 需要（signature|privileged，工程固件可装） -->
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_TASKS" />

    <!--
        桌面浮窗（overlay）。

        **这是做"浮在桌面上的小窗"的必要条件**（2026-11-07 实测）：
        Activity + resizeableActivity 只能让窗口不铺满**自己的任务栈**，
        一旦按 HOME 或者桌面盖上来，Activity 窗口就被挡住/退到后面。
        真正浮在所有应用之上的只有 WindowManager 的 overlay 窗口，
        而它必须持有 SYSTEM_ALERT_WINDOW。

        appops 实测：未声明时 `appops set ... allow` 写入无效
        （dumpsys appops 里永远是 "SYSTEM_ALERT_WINDOW (default)" 带 Reject 记录）。
        声明之后才能通过「设置 → 应用 → 显示在其他应用上层」或 adb appops 授权。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
        车机导航 OpenAPI（2026-11-07 实测确认）。

        **这是"不用 root 拿导航数据"的关键**：
          · 权限级别 = normal（pm list permissions 实测 protectionLevel:normal）
            → 声明即得，无需用户授权，无需 root
          · 服务端 = ecarx.naviservice/.service.NaviService
          · 接口   = ecarx.naviservice.INaviServer
          · 数据   = getTurnId / laneInfos / lightCountDown /
                     ISpeedLimitInfoBean / getRemainTime / trafficLightDistance

        对比 Frida 路线（需注入 com.geely.map 进程，需要 root）：
          · 这套是正规 AIDL 接口，零侵入
          · 而且比参考源码的 Frida 脚本**多一项限速**（ISpeedLimitInfoBean），
            flyme_navigation_reader.js 里没有提取限速
    -->
    <uses-permission android:name="ecarx.oem.permission.OPENAPI_NAVI_PERMISSION" />

    <!--
        ══════════════════════════════════════════════════════════════
        EVCC 开放 API（2026-11-12 接入）

        为什么加：VHAL 里 0x11400e01（远光）/ 0x11400e03（双闪）
        这两个属性的 timestamp 恒为 0 —— VHAL 层根本没接入这两个信号，
        拿到的 [1] 只是 CarService 的初始化默认值，与实车完全无关。

        EVCC 自己维护了 5+ 路属性源（VHAL / APVP / Vehicle AIDL /
        CAPI / AdaptAPI / SOA），并通过标准 AIDL 暴露出来。
        走这条通道可以拿到 VHAL 层拿不到的真实值。

        权限是 normal 级（声明即得），但**仍需用户在 EVCC 里手动授权**：
        EVCC → 服务 → 实验功能 → EVCC 开放 API → 开放 API 控制台
              → 开放权限的应用 → 勾选 Dashcast → 选「只读」或「标准联动」
        ══════════════════════════════════════════════════════════════
    -->
    <uses-permission android:name="com.kooo.evcc.permission.ACCESS_EVCC_API" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Android 11+ 包可见性：要 bind ecarx.naviservice 必须能看见它 -->
        <package android:name="ecarx.naviservice" />
        <!-- EVCC 开放 API：Android 11+ 包可见性，bind 前必须能看见 -->
        <package android:name="com.kooo.evcc" />
    </queries>

    <!-- ══════════════════════════════════════════════════════════
         WebView 声明为「可选」

         车机上实测（2026-11-10，SE1000 / Android 11）：
           com.android.webview 83.0.4103.120 —— 在，但版本老（Chromium 83）
         别的车机 ROM 有可能整个裁掉 WebView（省内存）。

         如果不加 required="false"，而目标机确实没有 WebView，
         APK 会直接装不上（INSTALL_FAILED_MISSING_SHARED_LIBRARY）。
         加上之后装得上，运行时由 MapDashView.isWebViewAvailable()
         判断，没有就降级 / 提示，不会白屏崩掉。
         ══════════════════════════════════════════════════════════ -->
    <uses-feature
        android:name="android.software.webview"
        android:required="false" />

    <application
        android:label="Dashcast"
        android:name=".DashcastApp"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Dashcast"
        android:allowBackup="false">

        <!--
            主界面。

            **必须 singleTask**：默认 standard 模式下每一次 am start 都会新建一个
            Activity 实例，每个实例都挂一个 fillxfill 的全屏窗口。实测从 launcher
            点几次、adb 再 start 几次，同一个进程里就堆出 3 个
            com.hermes.dashcast/MainActivity 窗口（token 各不同），
            结果仪表上看到「几份相同画面叠在一起」—— 被误判成投屏重影。

            singleTask 保证栈里只有一个实例，再次启动只是把它 bringToFront。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WebView 性能自检：跑 assets/perf-test.html，结果打到 logcat。
             启动：adb shell am start -n com.hermes.dashcast/.WebViewPerfActivity
             看结果：adb logcat -s DashcastPerf -->
        <activity
            android:name=".WebViewPerfActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density" />

        <!-- Java 渲染自检：DashView(Choreographer) → VD → ImageReader。
             启动：adb shell am start -n com.hermes.dashcast/.DashPerfActivity
             看结果：adb logcat -s DashPerf -->
        <activity
            android:name=".DashPerfActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density" />

        <!-- Java 渲染 VD 内容 dump：验证画面正确性，dump 一张即退 -->
        <activity
            android:name=".DashDumpActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density" />


        <!-- 镜像模式：只用来把进程钉在前台，逻辑在 Activity 进程里 -->
        <service
            android:name=".KeepAliveService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- 可视化图层布局编辑器：圆角/梯形/羽化形状遮罩，参数即时下发到 dcapd2。
             同样要 singleTask —— 反复进编辑器不该堆多个实例。 -->
        <activity
            android:name=".LayerEditorActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:label="图层布局" />

        <!-- 联调用：一块确定会动的 60fps 内容源，没有 launcher 入口。
             用法：am start 时用 display 参数指定虚拟屏 id -->
        <activity
            android:name=".TestPatternActivity"
            android:exported="true"
            android:launchMode="singleInstance" />

        <!--
            浮窗（overlay）测试页。

            MiniWindowActivity 是「Activity 不铺满」，按 HOME 会退到后台；
            MiniOverlay 是「WindowManager overlay」，浮在所有 App 之上。
            这个测试页两者都能验，用来对比。

            用法：
              adb shell am start -n com.hermes.dashcast/.OverlayTestActivity
        -->
        <activity
            android:name=".OverlayTestActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="浮窗测试" />

        <!--
            导航 OpenAPI 绑定验证页。

            验证「不用 root 能不能拿到导航数据」：
              ① 声明 ecarx.oem.permission.OPENAPI_NAVI_PERMISSION（normal 级）
              ② bind ecarx.naviservice/.service.NaviService
              ③ 拿到 IBinder 后打印 interface descriptor
              ④ 探测事务码看 Binder 是否响应

            用法：
              adb shell am start -n com.hermes.dashcast/.NaviBindTestActivity
        -->
        <activity
            android:name=".NaviBindTestActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="导航绑定验证" />

        <!--
            小窗（浮窗）。

            配置对齐银河视界的 SrMiniActivity（车机浮窗的既有范式）：
              · taskAffinity 独立      → 不和主界面挤同一个任务栈
              · launchMode=singleTask  → 反复拉起只 bringToFront，不堆实例
              · resizeableActivity=true → 允许系统给它非全屏尺寸
              · configChanges 0x1f80   = orientation|screenSize|screenLayout|density
                （尺寸变化时不重建 Activity，浮窗才不会闪一下）

            exported=true 只为能用 adb 直接 start 调试验证；
            正式入口走 MainActivity 里的 MiniWindowActivity.launch()。
        -->
        <activity
            android:name=".MiniWindowActivity"
            android:exported="true"
            android:taskAffinity="com.hermes.dashcast.mini"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density"
            android:resizeableActivity="true"
            android:label="小窗测试" />

        <!-- 联调用：adb shell am broadcast -a com.hermes.dashcast.DIAG
             把 CP（仪表）和 AP（中控）两边的状态一次性打到 logcat。

             **CPCMD 在 CP 上以 root 执行任意命令**（还能 push 落地二进制）。
             加固方式与取舍（2026-11-01）：
               ① 试过 signature 级自定义权限 —— 三方 App 确实挡得住，
                  但**把 adb shell 调试也一起挡死了**（adb 没我们的签名，
                  am 的 receiver-permission 参数在这台车机上也无效）。
                  车机上唯一的调试通道就是 adb，堵死它得不偿失。
               ② 最终方案：保持 exported=true，在 DiagReceiver.onReceive 里
                  按发送方 uid 校验（本 App / root / shell / system 放行）。
                  拿不到 uid 时放行并记日志 —— 这台车机的 framework 上
                  getSentFromUid() 运行时会 NoSuchMethodError，实际总是拿不到，
                  所以第一道防线在 uid 上不可靠，**主要靠"广播 action 名字
                  不公开、且只有 root/adb 才知道用法"这一层模糊防护**。
               ③ 真要收紧：把 exported 改成 false，然后在 MainActivity 里
                  加一个诊断按钮走进程内调用（不再依赖广播）。 -->
        <receiver
            android:name=".DiagReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.hermes.dashcast.DIAG" />
                <action android:name="com.hermes.dashcast.CPCMD" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
